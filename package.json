{
  "name": "neospace",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prebuild": "node scripts/build-prepaint.mjs",
    "build": "nuxt build",
    "predev": "node scripts/build-prepaint.mjs",
    "dev": "nuxt dev",
    "prepaint": "node scripts/build-prepaint.mjs",
    "generate": "node scripts/build-prepaint.mjs && nuxt generate && node scripts/spa-fallback.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc -p functions/tsconfig.json --noEmit",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "typecheck:app": "nuxt typecheck",
    "lint:rules": "eslint app functions scripts --max-warnings=0",
    "lint": "npm run lint:rules && npm run typecheck && npm run typecheck:e2e && npm run typecheck:app",
    "check": "npm run lint:rules && npm run typecheck && npm run typecheck:e2e && npm run typecheck:app && npm test",
    "budget": "node scripts/precache-budget.mjs",
    "check:full": "npm run check && npm run generate && npm run budget && npm run test:e2e",
    "analyze": "nuxt analyze",
    "cf:preview": "npm run generate && wrangler pages dev",
    "cf:deploy": "npm run generate && wrangler pages deploy --commit-dirty=true",
    "cf:deploy:ci": "npm run generate && wrangler pages deploy"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.11.3",
    "dompurify": "^3.4.16",
    "masto": "^7.12.0",
    "nuxt": "^4.5.2",
    "three": "^0.186.1",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20261012.1",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@fontsource/josefin-sans": "^5.3.0",
    "@fontsource/josefin-slab": "^5.3.0",
    "@fontsource/libre-franklin": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/roboto-slab": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@fontsource/source-code-pro": "^5.3.1",
    "@fontsource/source-sans-3": "^5.3.1",
    "@fontsource/source-serif-4": "^5.3.1",
    "@fontsource/space-mono": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.2",
    "sass": "^1.105.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^2.1.9",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.0.8",
    "wrangler": "^4.147.0"
  }
}
