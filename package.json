{
  "name": "neoSpace",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate && node scripts/spa-fallback.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf:preview": "npm run generate && wrangler pages dev",
    "cf:deploy": "npm run generate && wrangler pages deploy --commit-dirty=true"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.11.3",
    "masto": "^7.12.0",
    "nuxt": "^4.5.2",
    "sass": "^1.105.1",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "vitest": "^2.1.9",
    "wrangler": "^4.147.0"
  }
}
