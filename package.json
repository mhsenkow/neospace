{
  "name": "neospace",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "prepaint": "node scripts/build-prepaint.mjs",
    "generate": "node scripts/build-prepaint.mjs && nuxt generate && node scripts/spa-fallback.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p functions/tsconfig.json --noEmit",
    "typecheck:app": "nuxt typecheck",
    "lint": "echo 'eslint not configured — use typecheck + test' && exit 0",
    "check": "npm run typecheck && npm test",
    "analyze": "nuxt analyze",
    "cf:preview": "npm run generate && wrangler pages dev",
    "cf:deploy": "npm run generate && wrangler pages deploy --commit-dirty=true",
    "cf:deploy:ci": "npm run generate && wrangler pages deploy"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.11.3",
    "dompurify": "^3.4.16",
    "masto": "^7.12.0",
    "nuxt": "^4.5.2",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vite-pwa/nuxt": "^1.1.1",
    "typescript": "^5.9.3",
    "@vitest/coverage-v8": "^2.1.9",
    "sass": "^1.105.1",
    "vitest": "^2.1.9",
    "vue-tsc": "^3.0.8",
    "wrangler": "^4.147.0"
  }
}
